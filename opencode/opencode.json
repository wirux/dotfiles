    "opencode-snip@latest",
    "@ramtinj95/opencode-tokenscope",
    "@slkiser/opencode-quota",
    "oh-my-openagent@latest"
  ],
  "tui": {
    "scroll_speed": 3,
    "scroll_acceleration": {
      "enabled": true
    }
  },
  "keybinds": {
    "leader": "ctrl+s"
