{
  "$schema": "https://opencode.ai/config.json",
  "model": "google/gemini-3-pro-preview",
  "small_model": "google/gemini-2.5-flash-lite",
  "mcp": {
    "nobleBrainer": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@wirux/mcp-markdown-vault@latest"
      ],
      "enabled": true,
      "environment": {
        "VAULT_PATH": "/Users/adamwilczek/Library/Mobile Documents/iCloud~md~obsidian/Documents/nobleBrainer"
      }
    }
  },
  "provider": {
    "google": {
      "models": {
        "gemini-3-high": {
          "name": "Gemini 3 High",
          "id": "gemini-3-pro-preview",
          "options": {
            "thinking_level": "high",
            "safetySettings": [
              {
                "category": "HARM_CATEGORY_HATE_SPEECH",
                "threshold": "BLOCK_ONLY_HIGH"
              },
              {
                "category": "HARM_CATEGORY_DANGEROUS_CONTENT",
                "threshold": "BLOCK_ONLY_HIGH"
              },
              {
                "category": "HARM_CATEGORY_SEXUALLY_EXPLICIT",
                "threshold": "BLOCK_ONLY_HIGH"
              },
              {
                "category": "HARM_CATEGORY_HARASSMENT",
                "threshold": "BLOCK_ONLY_HIGH"
              }
            ]
          }
        },
        "gemini-3-low": {
          "name": "Gemini 3 Low",
          "id": "gemini-3-pro-preview",
          "options": {
            "temperature": 0.2,
            "topP": 0.95,
            "maxOutputTokens": 2048,
            "thinking_level": "low",
            "systemInstruction": "Return only code or brief explanations. No filler text.",
            "safetySettings": [
              {
                "category": "HARM_CATEGORY_HATE_SPEECH",
                "threshold": "BLOCK_ONLY_HIGH"
              },
              {
                "category": "HARM_CATEGORY_DANGEROUS_CONTENT",
                "threshold": "BLOCK_ONLY_HIGH"
              },
              {
                "category": "HARM_CATEGORY_SEXUALLY_EXPLICIT",
                "threshold": "BLOCK_ONLY_HIGH"
              },
              {
                "category": "HARM_CATEGORY_HARASSMENT",
                "threshold": "BLOCK_ONLY_HIGH"
              }
            ]
          }
        },
        "gemini-2.5-flash": {
          "name": "Gemini 2.5 Flash (Gemini CLI)",
          "limit": {
            "context": 1048576,
            "output": 65536
          },
          "modalities": {
            "input": [
              "text",
              "image",
              "pdf"
            ],
            "output": [
              "text"
            ]
          }
        },
        "gemini-2.5-pro": {
          "name": "Gemini 2.5 Pro (Gemini CLI)",
          "limit": {
            "context": 1048576,
            "output": 65536
          },
          "modalities": {
            "input": [
              "text",
              "image",
              "pdf"
            ],
            "output": [
              "text"
            ]
          }
        },
        "gemini-3-flash-preview": {
          "name": "Gemini 3 Flash Preview (Gemini CLI)",
          "limit": {
            "context": 1048576,
            "output": 65536
          },
          "modalities": {
            "input": [
              "text",
